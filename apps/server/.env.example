# Server
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# Origin of the Next.js app allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Secret used to sign session JWTs (min 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Secret used to sign cookies, e.g. the docs session (min 32 chars)
COOKIE_SECRET=change-me-to-another-long-random-string-32-chars

# Swagger UI at /docs, behind the sign-in page at /docs/login
DOCS_ENABLED=true
DOCS_USER=docs
DOCS_PASSWORD=change-me-please

# Dashboard sign-in (one shared team account; these are the demo credentials)
APP_USER=marketing
APP_PASSWORD=change-me-please

# The case's SQLite file, opened read-only. Keep it outside the repo (it must not be
# committed); an absolute path is safest. Tests read it from here too.
DB_PATH=/path/to/ad-performance-tool-case/data/livensa.db

# The case folder (the unzipped ad-performance-tool-case). The agent reads glossary.md,
# team-notes.md and build-logs/ from it at boot. Keep it outside the repo too.
CASE_DIR=/path/to/ad-performance-tool-case

# Team rules added on the dashboard's Rules page are saved here (created on the first
# rule; relative to apps/server). This is the only file the server writes.
RULES_PATH=data/team-rules.json

# Tiles pinned to the overview from agent answers (the agent's saved lookup, re-run on each
# visit). Also written by the server, next to the rules.
PINS_PATH=data/pinned-tiles.json

# Agent answers saved as insights (frozen reports with the evidence the agent read). Written
# by the server too. Saving needs no extra secret: snapshots are signed with a key derived from JWT_SECRET.
INSIGHTS_PATH=data/insights.json

# Observability: agent runs, their model/tool spans and warn/error logs are kept in this SQLite
# file (created on boot, relative to apps/server), apart from the read-only case data. Keep it
# on a persistent volume in production. Older entries are deleted after TELEMETRY_RETENTION_DAYS.
TELEMETRY_PATH=data/telemetry.db
TELEMETRY_RETENTION_DAYS=30

# The agent's models, through ZenMux (https://zenmux.ai, OpenAI-compatible). Create a key in
# the ZenMux console and paste it into your own .env only. Leave it empty to run without the agent.
ZENMUX_API_KEY=
# Default model when the dashboard doesn't pick one: deepseek/deepseek-v4.1-flash,
# z-ai/glm-5.2 or openai/gpt-6.1-sol (the list is AGENT_MODELS in src/constants/agent.constant.ts).
AGENT_MODEL=deepseek/deepseek-v4.1-flash

# AI creative images (Creative Studio). ZenMux serves image models on a separate endpoint
# (its Vertex AI protocol) from the agent's text models. Leave IMAGE_API_KEY empty to use
# ZENMUX_API_KEY; with neither set, the studio still writes concepts (if the agent is on) but
# can't generate images. Every image is billed, so IMAGE_DAILY_LIMIT caps them per UTC day.
IMAGE_API_KEY=
IMAGE_MODEL=klingai/kling-v3
IMAGE_DAILY_LIMIT=40
# Saved creatives (JSON) and their image files, written by the server next to the other data.
# Use a persistent volume in production: a container's own filesystem is lost on redeploy.
CREATIVES_PATH=data/creatives.json
CREATIVE_ASSETS_DIR=data/creatives

# MCP endpoint for ChatGPT (Settings → Apps & Connectors → Developer mode), served at
# /mcp/<MCP_SECRET>. The unguessable path is its only protection, so it needs 32+ characters
# (letters, digits, - or _). Generate: openssl rand -hex 32. Leave it empty to turn MCP off.
MCP_SECRET=
