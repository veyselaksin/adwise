# Server
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# Origin of the Next.js app allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Secret used to sign session JWTs (min 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Secret used to sign cookies, e.g. the docs session (min 32 chars)
COOKIE_SECRET=change-me-to-another-long-random-string-32-chars

# Swagger UI at /docs, behind the sign-in page at /docs/login
DOCS_ENABLED=true
DOCS_USER=docs
DOCS_PASSWORD=change-me-please

# Dashboard sign-in (one shared team account; these are the demo credentials)
APP_USER=marketing
APP_PASSWORD=change-me-please

# The case's SQLite file, opened read-only. Keep it outside the repo (it must not be
# committed); an absolute path is safest. Tests read it from here too.
DB_PATH=/path/to/ad-performance-tool-case/data/livensa.db
